{
  "name": "function-analyzer",
  "displayName": "Function Analyzer ",
  "description": "Анализ длины и вложенности С++ функций ",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "functionAnalyzer.run",
        "title": "Analyze C++ Functions"
      }
    ],
    "keybindings": [
      {
        "command": "functionAnalyzer.run",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "functionAnalyzer.run",
          "when": "editorLangId == cpp"
        }
      ]
    },
    "configuration": {
      "title": "Function Analyzer",
      "properties": {
        "functionAnalyzer.maxLength": {
          "type": "number",
          "default": 30,
          "description": "Макс. длина функции в строках"
        },
        "functionAnalyzer.maxDepth": {
          "type": "number",
          "default": 3,
          "description": "Макс. вложенность {}"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}